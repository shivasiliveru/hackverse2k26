# ---------------------------------------------------------------------------
# HackVerse 2K26 — environment template
#
# Copy any missing values into the real files. Note which file each one goes in:
#
#   .env        — tracked in git. Public values ONLY. Already filled in.
#   .env.local  — gitignored (`*.local`). Secrets go here. Never commit.
# ---------------------------------------------------------------------------


# --- Already present and working in .env — you do NOT need to re-fetch these ---

# Supabase project REST URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# Publishable ("anon") key — safe to expose to browsers; RLS protects the data.
# New-format keys start with `sb_publishable_`.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Not read by any application code — Lovable/Supabase CLI tooling only.
# The CLI takes the project ref from supabase/config.toml instead.
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=


# --- MISSING: the only value you need to fetch. Put it in .env.local ---

# Secret server-side key. Bypasses RLS, so it must never reach the browser
# or a git commit. Read by src/integrations/supabase/client.server.ts.
#
# Without it these all fail:
#   - participant team verification (/select step 01)
#   - the atomic allocation RPC (confirm & lock)
#   - every admin dashboard page
#
# Get it at:
#   https://supabase.com/dashboard/project/xsjslthabdzzvygpobwb/settings/api-keys
#
# Either format works — the client detects which you used:
#   new    -> "Secret keys" section, starts with `sb_secret_`   (preferred:
#             your publishable key is already new-format)
#   legacy -> "Legacy API keys" section, the `service_role` JWT, starts with
#             `eyJ`
SUPABASE_SERVICE_ROLE_KEY=
